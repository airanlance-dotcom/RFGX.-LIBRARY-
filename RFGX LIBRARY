-- ================= NOTIFICATION SYSTEM (Battery Charging Bar & Queue) =================
local NotifContainer = Instance.new("ScreenGui")
NotifContainer.Name = "RFGX_Notifications"
NotifContainer.Parent = game:GetService("CoreGui")

local notifQueue = {}
local isNotifActive = false

local function ProcessNotificationQueue()
    if isNotifActive or #notifQueue == 0 then return end
    isNotifActive = true
    
    local notifData = table.remove(notifQueue, 1)
    local titleText = notifData.title
    local messageText = notifData.msg

    -- Main Box (Bottom-Right)
    local NotifBox = Instance.new("Frame")
    NotifBox.Size = UDim2.new(0, 240, 0, 65)
    NotifBox.Position = UDim2.new(1, -250, 1, -80)
    NotifBox.BackgroundColor3 = Color3.fromRGB(25, 25, 25)
    NotifBox.BorderSizePixel = 0
    NotifBox.ZIndex = 20
    NotifBox.Parent = NotifContainer

    local NotifStroke = Instance.new("UIStroke")
    NotifStroke.Color = Color3.fromRGB(60, 60, 60)
    NotifStroke.Thickness = 1
    NotifStroke.Parent = NotifBox

    -- Title Label
    local TitleLbl = Instance.new("TextLabel")
    TitleLbl.Size = UDim2.new(1, -30, 0, 20)
    TitleLbl.Position = UDim2.new(0, 8, 0, 6)
    TitleLbl.BackgroundTransparency = 1
    TitleLbl.Text = titleText
    TitleLbl.TextColor3 = Color3.fromRGB(255, 255, 255)
    TitleLbl.Font = Enum.Font.GothamBold
    TitleLbl.TextSize = 12
    TitleLbl.TextXAlignment = Enum.TextXAlignment.Left
    TitleLbl.ZIndex = 21
    TitleLbl.Parent = NotifBox

    -- Message Label
    local MsgLbl = Instance.new("TextLabel")
    MsgLbl.Size = UDim2.new(1, -16, 0, 24)
    MsgLbl.Position = UDim2.new(0, 8, 0, 26)
    MsgLbl.BackgroundTransparency = 1
    MsgLbl.Text = messageText
    MsgLbl.TextColor3 = Color3.fromRGB(180, 180, 180)
    MsgLbl.Font = Enum.Font.Gotham
    MsgLbl.TextSize = 11
    MsgLbl.TextXAlignment = Enum.TextXAlignment.Left
    MsgLbl.TextWrapped = true
    MsgLbl.ZIndex = 21
    MsgLbl.Parent = NotifBox

    -- Queue Badge Number (if more notifications are waiting behind)
    if #notifQueue > 0 then
        local Badge = Instance.new("TextLabel")
        Badge.Size = UDim2.new(0, 22, 0, 16)
        Badge.Position = UDim2.new(1, -48, 0, 6)
        Badge.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
        Badge.Text = "+" .. tostring(#notifQueue)
        Badge.TextColor3 = Color3.fromRGB(255, 255, 255)
        Badge.Font = Enum.Font.GothamBold
        Badge.TextSize = 10
        Badge.ZIndex = 22
        Badge.Parent = NotifBox
        
        local BadgeCorner = Instance.new("UICorner")
        BadgeCorner.CornerRadius = UDim.new(1, 0)
        BadgeCorner.Parent = Badge
    end

    -- Top Right [X] Close Button
    local CloseBtn = Instance.new("TextButton")
    CloseBtn.Size = UDim2.new(0, 20, 0, 20)
    CloseBtn.Position = UDim2.new(1, -22, 0, 4)
    CloseBtn.BackgroundTransparency = 1
    CloseBtn.Text = "X"
    CloseBtn.TextColor3 = Color3.fromRGB(150, 150, 150)
    CloseBtn.Font = Enum.Font.GothamBold
    CloseBtn.TextSize = 12
    CloseBtn.ZIndex = 22
    CloseBtn.Parent = NotifBox

    -- Red Battery Charging Bar (Starts at 0 width, grows up to full 100%)
    local RedBarTrack = Instance.new("Frame")
    RedBarTrack.Size = UDim2.new(1, 0, 0, 3)
    RedBarTrack.Position = UDim2.new(0, 0, 1, -3)
    RedBarTrack.BackgroundColor3 = Color3.fromRGB(50, 20, 20)
    RedBarTrack.BorderSizePixel = 0
    RedBarTrack.ZIndex = 21
    RedBarTrack.Parent = NotifBox

    local RedBarFill = Instance.new("Frame")
    RedBarFill.Size = UDim2.new(0, 0, 1, 0) -- Starts empty
    RedBarFill.BackgroundColor3 = Color3.fromRGB(255, 50, 50)
    RedBarFill.BorderSizePixel = 0
    RedBarFill.ZIndex = 22
    RedBarFill.Parent = RedBarTrack

    local dismissed = false
    local function dismiss()
        if dismissed then return end
        dismissed = true
        if NotifBox and NotifBox.Parent then
            NotifBox:TweenPosition(UDim2.new(1, 20, 1, -80), Enum.EasingDirection.In, Enum.EasingStyle.Quad, 0.2, true, function()
                NotifBox:Destroy()
                isNotifActive = false
                task.wait(0.3)
                ProcessNotificationQueue()
            end)
        end
    end

    CloseBtn.MouseButton1Click:Connect(dismiss)

    -- Battery Bar Charging Up to Full (3 seconds duration)
    RedBarFill:TweenSize(UDim2.new(1, 0, 1, 0), Enum.EasingDirection.Linear, Enum.EasingStyle.Linear, 3, true, function()
        dismiss()
    end)
end

local function SendNotification(titleText, messageText)
    table.insert(notifQueue, {title = titleText, msg = messageText})
    ProcessNotificationQueue()
end

-- ================= TOP HEADER BAR & DRAGGING =================
local TopBar = Instance.new("Frame")
TopBar.Name = "TopBar"
TopBar.Size = UDim2.new(1, 0, 0, 36)
TopBar.Position = UDim2.new(0, 0, 0, 0)
TopBar.BackgroundTransparency = 1
TopBar.ZIndex = 2
TopBar.Parent = Box

local dragging, dragInput, dragStart, startPos
TopBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = Box.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)

TopBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        Box.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

